# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=postmisched -verify-misched %s -o - | FileCheck -check-prefix=GFX950 %s

# Transcendental and packed F32 instructions never issue in parallel with an
# MFMA. Other VALU should take the cycles the MFMA is busy before them.

---
name: valu_before_trans
tracksRegLiveness: true

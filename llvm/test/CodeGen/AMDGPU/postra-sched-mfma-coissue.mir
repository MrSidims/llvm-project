# Packed F32 instructions never issue in parallel with an MFMA either, and
# splitting them into co-issuable halves costs VALU cycles. Other VALU takes
# the shadow and the packed ops go ahead of the next MFMA instead of into its
# shadow.

---
name: valu_before_packed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr10_vgpr11, $vgpr12_vgpr13, $vgpr14_vgpr15, $vgpr16, $vgpr17, $vgpr18, $vgpr20_vgpr21, $vgpr22, $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15, $agpr16_agpr17_agpr18_agpr19_agpr20_agpr21_agpr22_agpr23_agpr24_agpr25_agpr26_agpr27_agpr28_agpr29_agpr30_agpr31


; The join barrier covers the branch barriers on every path.
define amdgpu_kernel void @diamond_barriers(i1 %c, ptr addrspace(1) %out) {
; CHECK-LABEL: @diamond_barriers(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    store i32 1, ptr addrspace(3) @lds, align 4
; CHECK-NEXT:    br i1 [[C:%.*]], label [[THEN:%.*]], label [[ELSE:%.*]]
; CHECK:       then:
; CHECK-NEXT:    br label [[JOIN:%.*]]
; CHECK:       else:
; CHECK-NEXT:    br label [[JOIN]]
; CHECK:       join:
; CHECK-NEXT:    call void @llvm.amdgcn.s.barrier()
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr addrspace(3) @lds, align 4
; CHECK-NEXT:    store i32 [[V]], ptr addrspace(1) [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  store i32 1, ptr addrspace(3) @lds
  br i1 %c, label %then, label %else

then:
  call void @llvm.amdgcn.s.barrier()
  br label %join

else:

; CHECK-LABEL: @wave_divergent_barriers(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br i1 [[C:%.*]], label [[PRODUCER:%.*]], label [[CONSUMER:%.*]]
; CHECK:       producer:
; CHECK-NEXT:    store i32 42, ptr addrspace(3) @lds, align 4
; CHECK-NEXT:    call void @llvm.amdgcn.s.barrier()
; CHECK-NEXT:    br label [[JOIN:%.*]]
; CHECK:       consumer:
; CHECK-NEXT:    call void @llvm.amdgcn.s.barrier()
; CHECK-NEXT:    br label [[JOIN]]
; CHECK:       join:
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr addrspace(3) @lds, align 4
; CHECK-NEXT:    store i32 [[V]], ptr addrspace(1) [[OUT:%.*]], align 4
; CHECK-NEXT:    ret void
;
entry:
  br i1 %c, label %producer, label %consumer

producer:

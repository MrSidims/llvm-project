  br label %join

join:
  call void @llvm.amdgcn.s.barrier()
  %v = load i32, ptr addrspace(3) @lds
  store i32 %v, ptr addrspace(1) %out
  ret void
}

; The barrier orders LDS accesses across loop iterations and must stay.
define amdgpu_kernel void @loop_barrier_lds(ptr addrspace(1) %out, i32 %n) {

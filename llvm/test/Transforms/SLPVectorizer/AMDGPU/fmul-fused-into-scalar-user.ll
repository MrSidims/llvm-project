  %m1 = fmul contract float %a1, %b1
  %m2 = fmul contract float %a2, %b2
  %m3 = fmul contract float %a3, %b3
  %s0 = fadd contract float %acc, %m0
  %s1 = fadd contract float %s0, %m1
  %s2 = fadd contract float %s1, %m2
  %s3 = fadd contract float %s2, %m3
  store float %s3, ptr %d, align 4
  ret void
}


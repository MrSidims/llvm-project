; CHECK-LABEL: define void @fma_chain_args(
; CHECK-SAME: ptr noalias [[D:%.*]], float [[A0:%.*]], float [[A1:%.*]], float [[A2:%.*]], float [[A3:%.*]], float [[B0:%.*]], float [[B1:%.*]], float [[B2:%.*]], float [[B3:%.*]], float [[ACC:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[M0:%.*]] = fmul contract float [[A0]], [[B0]]
; CHECK-NEXT:    [[M1:%.*]] = fmul contract float [[A1]], [[B1]]
; CHECK-NEXT:    [[M2:%.*]] = fmul contract float [[A2]], [[B2]]
; CHECK-NEXT:    [[M3:%.*]] = fmul contract float [[A3]], [[B3]]
; CHECK-NEXT:    [[S0:%.*]] = fadd contract float [[ACC]], [[M0]]
; CHECK-NEXT:    [[S1:%.*]] = fadd contract float [[S0]], [[M1]]
; CHECK-NEXT:    [[S2:%.*]] = fadd contract float [[S1]], [[M2]]
; CHECK-NEXT:    [[S3:%.*]] = fadd contract float [[S2]], [[M3]]
; CHECK-NEXT:    store float [[S3]], ptr [[D]], align 4
; CHECK-NEXT:    ret void
;
entry:
